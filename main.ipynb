    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "\n",
    "time = np.linspace(0, length, length)\n",
    "\n",
    "\n",
    "plt.rcParams.update({\n",
    "    \"font.family\": \"sans\",\n",
    "    \"mathtext.fontset\": \"dejavusans\",\n",
    "    \"font.size\": 11,\n",
    "    \"axes.labelsize\": 12,\n",
    "    \"legend.fontsize\": 9.5,\n",
    "    \"xtick.labelsize\": 10.5,\n",
    "    \"ytick.labelsize\": 10.5,\n",
    "    \"axes.linewidth\": 1.0,\n",
    "    \"xtick.direction\": \"out\",\n",
    "    \"ytick.direction\": \"out\"\n",
    "})\n",
    "\n",
    "soil_style = {\n",
    "    \"sand\":       (\"#c2b280\", \"o\"),\n",
    "    \"sandy loam\": (\"#d79044\", \"s\"),\n",
    "    \"loamy sand\": (\"#9d7643\", \"^\"),\n",
    "    \"loam\":       (\"#6a5637\", \"D\"),\n",
    "}\n",
    "\n",
    "# The same solver output is used for each soil type.\n",
    "\n",
    "def daily_average_Tr(Tr_vec):\n",
    "    Tr_vec = np.asarray(Tr_vec).squeeze()\n",
    "\n",
    "    steps_per_day = int(1 / dt)\n",
    "    n_days = int(length)\n",
    "\n",
    "    Tr_daily = []\n",
    "\n",
    "    for d in range(n_days):\n",
    "        start = d * steps_per_day\n",
    "        end = (d + 1) * steps_per_day\n",
    "\n",
    "        Tr_daily.append(np.nanmean(Tr_vec[start:end]))\n",
    "\n",
    "    t_daily = np.arange(n_days) + 0.5\n",
    "\n",
    "    return t_daily, np.asarray(Tr_daily)\n",
    "\n",
    "\n",
    "def clean_axis(ax, letter):\n",
    "    ax.spines[\"top\"].set_visible(False)\n",
    "    ax.spines[\"right\"].set_visible(False)\n",
    "    ax.grid(False)\n",
    "\n",
    "    ax.text(\n",
    "        -0.13, 1.04, letter,\n",
    "        transform=ax.transAxes,\n",
    "        fontsize=15,\n",
    "        fontweight=\"bold\",\n",
    "        va=\"bottom\",\n",
    "        ha=\"left\",\n",
    "        clip_on=False\n",
    "    )\n",
    "\n",
    "\n",
    "def plot_soil_panels(fname=\"soiltype_panels_one_column.pdf\"):\n",
    "\n",
    "    fig, axs = plt.subplots(\n",
    "        4, 1,\n",
    "        figsize=(6, 14),\n",
    "        dpi=250\n",
    "    )\n",
    "\n",
    "    ax_a, ax_c, ax_e, ax_g = axs\n",
    "\n",
    "    for soil_name, (color, marker) in soil_style.items():\n",
    "\n",
    "        CAPE, thetavir, hh, qqq, lcl, ss_vec, ssCAC, CT, Tr_vec, CAC, _ = soil_results[soil_name]\n",
    "\n",
    "        CAC = np.atleast_1d(np.asarray(CAC).squeeze())\n",
    "        ssCAC = np.atleast_1d(np.asarray(ssCAC).squeeze())\n",
    "        Tr_vec = np.asarray(Tr_vec).squeeze()\n",
    "\n",
    "        # Keep crossing records as arrays, even if a run has only one event.\n",
    "        # Time for CAC and ssCAC\n",
    "        t_CAC = time[:len(CAC)]\n",
    "        t_s = time[:len(ssCAC)]\n",
    "\n",
    "        # Time for Tr_vec, because Tr_vec may have int(length / dt) steps\n",
    "        t_Tr = np.linspace(0, length, len(Tr_vec))\n",
    "        t_Tr_daily, Tr_daily = daily_average(t_Tr, Tr_vec)\n",
    "\n",
    "        # CAC vs ssCAC\n",
    "        n = min(len(CAC), len(ssCAC))\n",
    "        CAC_s = CAC[:n]\n",
    "        ssCAC_s = ssCAC[:n]\n",
    "\n",
