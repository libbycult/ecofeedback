   "source": [
    "#Figure 2\n",
    "\n",
    "def run_drydown_curves(\n",
    "    s0=1,\n",
    "    psi=-4,\n",
    "    soil_type=\"sandy loam\",\n",
    "    save_base=\"drydown_march1\",\n",
    "    show=True,\n",
    "):\n",
    "    output = CAPE_solver(\n",
    "        800, psi, psimin(psi), gmax(psi), soil_type, s0\n",
    "    )\n",
    "    cape, _, h, _, _, soil, _, _, transpiration, _, _ = output\n",
    "\n",
    "    panels = [\n",
    "        (soil, r\"Relative Soil Moisture, $s$ (–)\"),\n",
    "        (transpiration, r\"Transpiration, $\\Phi$ (mm d$^{-1}$)\"),\n",
    "        (cape, r\"CAPE (J kg$^{-1}$)\"),\n",
    "        (h, r\"ABL Height, $h$ (m)\"),\n",
    "    ]\n",
    "\n",
    "    # Give each saved time step its matching day.\n",
    "    days = np.arange(len(soil)) * dt\n",
    "\n",
    "    style = {\n",
    "        \"figure.dpi\": 300,\n",
    "        \"savefig.dpi\": 300,\n",
    "        \"font.size\": 18,\n",
    "        \"axes.labelsize\": 18,\n",
    "        \"xtick.labelsize\": 18,\n",
    "        \"ytick.labelsize\": 18,\n",
    "        \"axes.linewidth\": 0.8,\n",
    "    }\n",
    "\n",
    "    with plt.rc_context(style):\n",
    "        fig, axes = plt.subplots(\n",
    "            2, 2,\n",
    "            figsize=(20, 8),\n",
    "            constrained_layout=True,\n",
    "            sharex=True,\n",
    "        )\n",
    "\n",
    "        for i, (ax, (data, ylabel)) in enumerate(\n",
    "            zip(axes.flat, panels)\n",
    "        ):\n",
    "            ax.plot(days, data, color=\"black\", lw=1.5)\n",
    "\n",
    "            ax.set(\n",
    "                xlabel=\"Time (days)\",\n",
    "                ylabel=ylabel,\n",
    "                xlim=(days[0], days[-1]),\n",
    "            )\n",
    "            ax.margins(x=0)\n",
    "            ax.spines[[\"top\", \"right\"]].set_visible(False)\n",
    "            ax.tick_params(direction=\"out\", length=5, width=1)\n",
    "\n",
    "            ax.text(\n",
    "                0.02,\n",
    "                1.05,\n",
    "                f\"({chr(97 + i)})\",\n",
    "                transform=ax.transAxes,\n",
    "                ha=\"left\",\n",
    "                va=\"top\",\n",
    "                fontsize=16,\n",
    "                fontweight=\"bold\",\n",
    "            )\n",
    "\n",
    "        for ext in (\"png\", \"pdf\"):\n",
    "            fig.savefig(\n",
    "                f\"{save_base}.{ext}\",\n",
    "                bbox_inches=\"tight\",\n",
    "            )\n",
    "\n",
    "        plt.show() if show else plt.close(fig)\n",
    "\n",
    "    return fig, axes\n",
    "\n",
    "\n",
    "fig, axes = run_drydown_curves(s0=1, psi=-4)\n"
   ]
  },
