    "#Figure 4\n",
    "\n",
    "\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from concurrent.futures import ProcessPoolExecutor\n",
    "\n",
    "# --- parameters ---\n",
    "P50, ZR = -4, 800\n",
    "psimin_val, gmax_val = psimin(P50), gmax(P50)\n",
    "\n",
    "time = np.linspace(0, length, length)\n",
    "\n",
    "soil_types = [\"sand\", \"sandy loam\", \"loamy sand\", \"loam\", \"clay\"]\n",
    "\n",
    "# Run independent soil-type cases in parallel.\n",
    "def compute_CAPE_for_soil(soil_name):\n",
    "    return CAPE_solver(ZR, P50, psimin_val, gmax_val, soil_name, 0.7)\n",
    "\n",
    "with ProcessPoolExecutor() as executor:\n",
    "    soil_results = dict(zip(soil_types, executor.map(compute_CAPE_for_soil, soil_types)))\n",
    "\n",
    "\n",
    "def daily_average(t, y):\n",
    "    t = np.asarray(t)\n",
    "    y = np.asarray(y)\n",
    "\n",
    "    bins = np.arange(0, length + 1, 1)\n",
    "    centers = bins[:-1] + 0.5\n",
    "\n",
    "    y_daily = []\n",
    "\n",
    "    for i in range(len(bins) - 1):\n",
    "        mask = (t >= bins[i]) & (t < bins[i + 1])\n",
    "\n",
    "        if np.any(mask):\n",
    "            y_daily.append(np.nanmean(y[mask]))\n",
    "        else:\n",
    "            y_daily.append(np.nan)\n",
    "\n",
    "    return centers, np.asarray(y_daily)\n"
   ]
