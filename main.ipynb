    "\n",
    "ZR = 800\n",
    "\n",
    "\n",
    "P50_values = [-1,-2, -4, -7]\n",
    "\n",
    "def compute_CAPE_for_P50(P50):\n",
    "    psimin_val = psimin(P50)\n",
    "    gmax_val = gmax(P50)\n",
    "\n",
    "    return CAPE_solver(ZR, P50, psimin_val, gmax_val, \"sandy loam\",0.7)\n",
    "\n",
    "\n",
    "P50_results = {P50: compute_CAPE_for_P50(P50) for P50 in P50_values}\n",
