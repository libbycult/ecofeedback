    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "\n",
    "time = np.linspace(0, length, length)\n",
    "\n",
    "\n",
    "plt.rcParams.update({\n",
    "    \"font.family\": \"sans\",\n",
    "    \"mathtext.fontset\": \"dejavusans\",\n",
    "    \"font.size\": 11,\n",
    "    \"axes.labelsize\": 12,\n",
    "    \"legend.fontsize\": 9.5,\n",
    "    \"xtick.labelsize\": 10.5,\n",
    "    \"ytick.labelsize\": 10.5,\n",
    "    \"axes.linewidth\": 1.0,\n",
    "    \"xtick.direction\": \"out\",\n",
    "    \"ytick.direction\": \"out\"\n",
    "})\n",
    "\n",
    "# Colors for P50 type\n",
    "P50_style = {\n",
    "    -1: (\"#e66101\", \"o\"),   # dark orange\n",
    "    -2: (\"#fdb863\", \"s\"),   # light orange\n",
    "    -4: (\"#b2abd2\", \"^\"),   # light purple\n",
    "    -7: (\"#5e3c99\", \"D\"),   # dark purple\n",
    "}\n",
    "\n",
    "#labels\n",
    "P50_labels = {\n",
    "    -1: r\"$-1$ MPa\",\n",
    "    -2: r\"$-2$ MPa\",\n",
    "    -4: r\"$-4$ MPa\",\n",
    "    -7: r\"$-7$ MPa\",\n",
    "}\n",
    "\n",
    "# Helper for averaging the saved transpiration series by day. \n",
    "\n",
    "def daily_average(t, y):\n",
    "    t = np.asarray(t)\n",
    "    y = np.asarray(y)\n",
    "\n",
    "    bins = np.arange(0, length + 1, 1)\n",
    "    centers = bins[:-1] + 0.5\n",
    "\n",
    "    y_daily = []\n",
    "\n",
    "    for i in range(len(bins) - 1):\n",
    "        mask = (t >= bins[i]) & (t < bins[i + 1])\n",
    "\n",
    "        if np.any(mask):\n",
    "            y_daily.append(np.nanmean(y[mask]))\n",
    "        else:\n",
    "            y_daily.append(np.nan)\n",
    "\n",
    "    return centers, np.asarray(y_daily)\n",
    "\n",
    "\n",
    "# Keep the panel axes consistent. \n",
    "def clean_axis(ax, letter):\n",
    "    ax.spines[\"top\"].set_visible(False)\n",
    "    ax.spines[\"right\"].set_visible(False)\n",
    "    ax.grid(False)\n",
    "\n",
    "    ax.text(\n",
    "        -0.16, 1.04, letter,\n",
    "        transform=ax.transAxes,\n",
    "        fontsize=15,\n",
    "        fontweight=\"bold\",\n",
    "        va=\"bottom\",\n",
    "        ha=\"left\",\n",
    "        clip_on=False\n",
    "    )\n",
    "\n",
    "\n",
    "# Plot the four panels.\n",
    "def plot_P50_panels(fname=\"P50_panels_one_column.pdf\"):\n",
    "\n",
    "    fig, axs = plt.subplots(\n",
    "        4, 1,\n",
    "        figsize=(6, 14),\n",
    "        dpi=250\n",
    "    )\n",
    "    ax_b, ax_d, ax_f, ax_h = axs\n",
    "\n",
    "    for P50, (color, marker) in P50_style.items():\n",
    "\n",
    "        CAPE, thetavir, hh, qqq, lcl, ss_vec, ssCAC, CT, Tr_vec, CAC, _ = P50_results[P50]\n",
    "\n",
    "        CAC = np.asarray(CAC).squeeze()\n",
    "        ssCAC = np.asarray(ssCAC).squeeze()\n",
    "        Tr_vec = np.asarray(Tr_vec).squeeze()\n",
    "\n",
    "        # Time for CAC and ssCAC (CAPE at crossing and soil moisture at CAPE crossing)\n",
    "        t_CAC = time[:len(CAC)]\n",
    "        t_s = time[:len(ssCAC)]\n",
    "\n",
    "        # Time for transpiration (with dt, not at crossing time)\n",
    "        t_Tr = np.linspace(0, length, len(Tr_vec))\n",
    "\n",
    "        # Daily averaged transpiration\n",
    "        t_Tr_daily, Tr_daily = daily_average(t_Tr, Tr_vec)\n",
    "\n",
    "        # CAPE at crossing vs ssCAC\n",
    "        n = min(len(CAC), len(ssCAC))\n",
    "        CAC_s = CAC[:n]\n",
    "        ssCAC_s = ssCAC[:n]\n",
    "\n",
    "        # Marker spacing\n",
    "        mark_CAC = max(1, len(t_CAC) // 12)\n",
    "        mark_s = max(1, len(ssCAC_s) // 12)\n",
    "        mark_Tr = max(1, len(t_Tr_daily) // 12)\n",
    "        mark_ss = max(1, len(t_s) // 12)\n",
    "\n",
    "        # -------------------------\n",
    "        # (b) CAC vs time\n",
    "        # -------------------------\n",
    "        ax_b.plot(\n",
    "            t_CAC, CAC,\n",
    "            color=color,\n",
    "            marker=marker,\n",
    "            markevery=mark_CAC,\n",
    "            linewidth=2.0,\n",
    "            markersize=4.3,\n",
    "            label=P50_labels[P50]\n",
    "        )\n",
    "\n",
    "        # -------------------------\n",
    "        # (d) CAC vs ssCAC\n",
    "        # -------------------------\n",
    "        ax_d.plot(\n",
    "            ssCAC_s, CAC_s,\n",
    "            color=color,\n",
    "            marker=marker,\n",
    "            markevery=mark_s,\n",
    "            linewidth=2.0,\n",
    "            markersize=4.3,\n",
    "            label=P50_labels[P50]\n",
    "        )\n",
    "\n",
    "        # -------------------------\n",
    "        # (f) daily averaged Tr_vec vs time\n",
    "        # -------------------------\n",
    "        ax_f.plot(\n",
    "            t_Tr_daily, Tr_daily,\n",
    "            color=color,\n",
    "            marker=marker,\n",
    "            markevery=mark_Tr,\n",
    "            linewidth=2.0,\n",
    "            markersize=4.3,\n",
    "            label=P50_labels[P50]\n",
    "        )\n",
    "\n",
    "        # -------------------------\n",
    "        # (h) ssCAC vs time\n",
    "        # -------------------------\n",
    "        ax_h.plot(\n",
    "            t_s, ssCAC,\n",
    "            color=color,\n",
    "            marker=marker,\n",
    "            markevery=mark_ss,\n",
    "            linewidth=2.0,\n",
    "            markersize=4.3,\n",
    "            label=P50_labels[P50]\n",
    "        )\n",
    "\n",
    "    cape_ylabel = r\"$\\mathrm{CAPE\\ at\\ Crossing}\\ (\\mathrm{J\\,kg^{-1}})$\"\n",
    "\n",
    "    ax_b.set_ylabel(cape_ylabel)\n",
    "    ax_b.set_xlabel(\"Time (days)\")\n",
    "    ax_b.set_xlim(0, length)\n",
    "    clean_axis(ax_b, \"(b)\")\n",
    "\n",
    "    ax_d.set_ylabel(cape_ylabel)\n",
    "    ax_d.set_xlabel(\"Relative Soil Moisture\")\n",
    "    clean_axis(ax_d, \"(d)\")\n",
    "\n",
    "    ax_f.set_ylabel(r\"Daily average $\\Phi$ ($\\mathrm{mm\\,d^{-1}}$)\")\n",
    "    ax_f.set_xlabel(\"Time (days)\")\n",
    "    ax_f.set_xlim(0, length)\n",
    "    clean_axis(ax_f, \"(f)\")\n",
    "\n",
    "    ax_h.set_ylabel(\"Relative Soil Moisture\")\n",
    "    ax_h.set_xlabel(\"Time (days)\")\n",
    "    ax_h.set_xlim(0, length)\n",
    "    clean_axis(ax_h, \"(h)\")\n",
    "\n",
    "    handles, labels = ax_b.get_legend_handles_labels()\n",
    "\n",
    "    fig.legend(\n",
    "        handles,\n",
    "        labels,\n",
    "        title=r\"$\\psi_{50,\\mathrm{stem}}$\",\n",
    "        loc=\"upper center\",\n",
    "        bbox_to_anchor=(0.5, 1.015),\n",
    "        ncol=4,\n",
    "        frameon=False\n",
    "    )\n",
    "\n",
    "    plt.tight_layout(rect=[0, 0, 1, 0.975])\n",
    "    plt.savefig(fname, dpi=250, bbox_inches=\"tight\")\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "plot_P50_panels(\"P50_panels_one_column.pdf\")"
   ]
