   "source": [
    "# Crossing times, rainfall, and atmospheric dynamics\n",
    "\n",
    "This notebook runs the model and produces the drydown, crossing-time, and sensitivity figures. The cells are arranged in the order they should be run, and the supporting Python files are included alongside the notebook.\n",
    "\n",
    "**Start here:** keep `Atmosphericdynamics.py`, `Functionsdiurnal.py`, and `ParamsECO.py` in the same folder as this notebook. Install the packages listed in `requirements.txt`. You can also run one figure section at a time after the setup and solver cells.\n",
    "\n",
    "Each figure section runs its own simulations, so running every section can take some time. The rainfall draws are not seeded (feel free to add a seed), so results can differ slightly between runs. Saved figure files appear in the notebook's working folder."
   ]
  },
  {
   "cell_type": "markdown",
   "id": "e9da70ce",
   "metadata": {},
   "source": [
    "## 1. Load packages and model functions\n",
    "\n",
    "The three local `.py` files hold the parameter settings and shared functions. Run this cell before anything else."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 27,
   "id": "84ebe1e9",
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np \n",
    "from matplotlib import pyplot as plt\n",
    "import random as rand\n",
    "from scipy.optimize import fsolve\n",
    "import scipy\n",
    "import math\n",
    "import matplotlib\n",
    "from scipy.optimize import root\n",
    "from scipy.special import lambertw\n",
    "from scipy.interpolate import interp1d\n",
    "from scipy.integrate import quad\n",
    "from scipy import integrate\n",
    "# Local files containing parameters and helper functions.\n",
    "import ParamsECO1\n",
    "import Functionsdiurnal1\n",
    "import Atmosphericdynamics1\n",
    "\n",
    "\n",
    "%load_ext autoreload\n",
    "%autoreload 2\n",
    "from ParamsECO1 import *\n",
    "from Functionsdiurnal1 import *\n",
    "from Atmosphericdynamics1 import *\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "0a2b3dda",
   "metadata": {},
   "source": [
    "## 2. Main simulation\n",
    "\n",
    "`CAPE_solver` runs a single scenario. Its output includes the time series and the crossing-event records used by the plots below. The simulation settings come from the accompanying Python files."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "fff065b6",
   "metadata": {},
   "outputs": [],
   "source": [
    "def CAPE_solver(Zr, psi_50, psi_min, gst_max, x, s00):\n",
    "    # Use the same atmospheric profiles for every time step in this run.\n",
    "    Zrm = Zr / 1000\n",
    "    gam_q = -2.1e-6\n",
    "    qf0 = 0.011\n",
    "    gam_theta = 0.0033\n",
    "    theta_f0 = 298\n",
    "\n",
    "    nsteps = int(length / dt)\n",
    "\n",
    "    def zeros():\n",
    "        return np.zeros(nsteps)\n",
    "\n",
    "    # Save the time history of each state variable.\n",
    "    H = zeros()\n",
    "    ss_vec = zeros()\n",
    "    ss_vec[0] = s00\n",
    "\n",
    "    ET_vec = zeros()\n",
    "    QW_vec = zeros()\n",
    "    Tr_vec = zeros()\n",
    "    psil_vec = zeros()\n",
    "    leaf_vec = zeros()\n",
    "    QS_vec = zeros()\n",
    "    psiw_vec = zeros()\n",
    "    psis_vec = zeros()\n",
    "    rain_vec = zeros()\n",
    "\n",
    "    hh = zeros()\n",
    "    qqq = zeros()\n",
    "    thetavir = zeros()\n",
    "    theta = zeros()\n",
    "    phi = zeros()\n",
    "    lcl = zeros()\n",
    "    CAPE = zeros()\n",
    "    STOM = zeros()\n",
    "\n",
    "    # Store crossings and the values recorded at each crossing.\n",
    "    CT = []\n",
    "    CAC = []\n",
    "    ssCAC = []\n",
    "\n",
    "    # soil parameters\n",
    "    n, emax, sfc, sw, sh, ss, Ks, psi_s0, b = soil_params(x)\n",
    "    Ksm = Ks * 1.15741e-8  # to m/s\n",
    "\n",
    "    # Keep track of daytime crossings and storm periods.\n",
    "    current_distance = 0\n",
    "    prev_sign = None\n",
    "    night_started = True\n",
    "    storm_started = False\n",
    "    storm_on = False\n",
    "\n",
    "    q_night = qf0\n",
    "    thetavir_night = theta_f0\n",
    "\n",
    "    # Leaf and soil quantities solved together at each time step.\n",
    "    def solving(i, args, ss):\n",
    "        psi_l, EE, Tl = args\n",
    "\n",
    "        f1 = ALP(\n",
    "            psi_l, EE, Tl,\n",
    "            qqq[i], psi_min, gst_max,\n",
    "            theta[i], phi[i]\n",
    "        )\n",
    "\n",
    "        f2 = Evap(\n",
    "            ss, psi_l, ws, EE, Tl,\n",
    "            Ksm, b, psi_s0, psi_50, Zrm\n",
    "        )\n",
    "\n",
    "        f3 = Tl_Evap(Tl, EE, phi[i], theta[i])\n",
    "\n",
    "        return f1, f2, f3\n",
    "\n",
    "    # Starting values for the root solver.\n",
    "    x0 = np.array([-0.5, 1.0, 300.0])\n",
    "\n",
    "    for i in range(nsteps - 1):\n",
    "        tid = (i * dt) % 1\n",
    "\n",
    "        # Daytime radiation.\n",
    "        phi[i] = max(\n",
    "            ((4 * 500) / (0.5 ** 2))\n",
    "            * (-tid ** 2 + tid - 0.25 * (0.25 + 0.5)),\n",
    "            0\n",
    "        )\n",
    "\n",
    "        # Start each day with the storm flag cleared.\n",
    "        if abs(tid - 0.25) < dt:\n",
    "            storm_on = False\n",
    "\n",
    "        if storm_on:\n",
    "            phi[i] = 0\n",
    "\n",
    "        # daytime atmosphere\n",
    "        if phi[i] != 0:\n",
    "            night_started = False\n",
    "\n",
    "            theta[i] = thetavir[i] / (1 + RAT * qqq[i])\n",
    "\n",
    "            lcl[i] = zlcl(theta[i], qqq[i])\n",
    "            tlcl, plcl = tp(lcl[i], theta[i])\n",
    "\n",
    "            PRECIP, PG, Tmp1, Tfv1, CAPEx = RAINC(\n",
    "                0.1, tlcl, plcl, lcl[i], 18000,\n",
    "                gam_q, qf0, hh[i], theta[i], qqq[i]\n",
    "            )\n",
    "\n",
    "            CAPE[i] = CAPEx\n",
    "\n",
    "        # nighttime atmosphere\n",
    "        else:\n",
    "            if not night_started and i > 0:\n",
    "                night_started = True\n",
    "\n",
    "            hh[i] = h0\n",
    "            qqq[i] = q_night\n",
    "            thetavir[i] = thetavir_night\n",
    "            theta[i] = thetavir[i] / (1 + 0.61 * qqq[i])\n",
    "\n",
    "            lcl[i] = zlcl(theta[i], qqq[i])\n",
    "            tlcl, plcl = tp(lcl[i], theta[i])\n",
    "\n",
    "            CAPE[i] = 0\n",
    "\n",
    "        # current soil state\n",
    "        ss = ss_vec[i]\n",
    "        ws = ws_vec[i]\n",
    "\n",
    "        # check LCL-BL crossing\n",
    "        if i > 0:\n",
    "            prev_distance = lcl[i - 1] - hh[i - 1]\n",
    "            current_distance = lcl[i] - hh[i]\n",
    "\n",
    "        is_daytime = 6 < ((i * dt * 24) % 24) < 18\n",
    "\n",
    "        if (\n",
    "            prev_sign is not None\n",
    "            and (current_distance > 0) != (prev_sign > 0)\n",
    "            and is_daytime\n",
    "            and not storm_started\n",
    "        ):\n",
    "            frac = abs(prev_distance) / (\n",
    "                abs(prev_distance) + abs(current_distance)\n",
    "            )\n",
    "\n",
    "            interp_i = (i - 1) + frac\n",
    "\n",
    "            CAPE_add = CAPE[i - 1] + frac * (CAPE[i] - CAPE[i - 1])\n",
    "            ss_add = ss_vec[i - 1] + frac * (ss_vec[i] - ss_vec[i - 1])\n",
    "            ct_val = (interp_i * dt * 24) % 24\n",
    "\n",
    "            CT.append(ct_val)\n",
    "            CAC.append(CAPE_add)\n",
    "            ssCAC.append(ss_add)\n",
    "            # Use the original crossing-event trigger.\n",
    "            if rand.uniform(0, 1) <= 0.2 and CAPE_add >= 400:\n",
    "                Tc = 1000#np.random.exponential(scale=1000)\n",
    "                hc = PRECIP / (n * Zr) * Tc + PG / (n * Zr)\n",
    "                #add in hc to rain vec to turn on rain.\n",
    "                rain_vec[i] = 0\n",
    "                cape_triggered = True\n",
    "\n",
    "        # Keep the original random rainfall draw.\n",
    "        if rand.uniform(0, 1) <= 0.1 * dt:\n",
    "            #replace 0 with number (mm) for mean rain depth.\n"
    "            rain_vec[i] += np.random.exponential(0 / (n * Zr))\n",
    "\n",
    "        if rain_vec[i] > 0:\n",
    "            storm_on = True\n",
    "\n",
    "        prev_sign = current_distance\n",
    "\n",
    "        # add rainfall to soil\n",
    "        ss_vec[i] = min(ss_vec[i] + rain_vec[i], 1)\n",
    "        ss = ss_vec[i]\n",
    "\n",
    "        # storm atmosphere reset\n",
    "        if storm_on:\n",
    "            if not storm_started:\n",
    "                storm_started = True\n",
    "\n",
    "            hh[i] = h0\n",
    "            qqq[i] = q_night\n",
    "            thetavir[i] = thetavir_night\n",
    "            phi[i] = 0\n",
    "            theta[i] = thetavir[i] / (1 + 0.61 * qqq[i])\n",
    "\n",
    "            lcl[i] = zlcl(theta[i], qqq[i])\n",
    "            tlcl, plcl = tp(lcl[i], theta[i])\n",
    "\n",
    "        else:\n",
    "            storm_started = False\n",
    "\n",
    "        # solve leaf/ET system\n",
    "        for _ in range(5):\n",
    "            result = root(lambda y: solving(i, y, ss), x0, method=\"hybr\")\n",
    "\n",
    "            if result.success and np.all(np.isfinite(result.x)):\n",
    "                break\n",
    "\n",
    "            x0 = x0 + 0.1 * np.random.randn(*x0.shape)\n",
    "\n",
    "        psi_l, EE, Tl = result.x\n",
    "\n",
    "        # sensible heat\n",
    "        H[i] = phi[i] - (lambda_w * rho_w * EE / conv)\n",
    "\n",
    "        if H[i] < 0:\n",
    "            H[i] = 0\n",
    "\n",
    "        # soil-plant variables\n",
    "        Tr_vec[i] = EE\n",
    "        psil_vec[i] = psi_l\n",
    "        leaf_vec[i] = Tl\n",
    "\n",
    "        ET_vec[i] = ET_L(ss, b, sh, Ks, 0)\n",
    "        QW_vec[i] = QW(psi_l, ws, ss, Tl, EE)\n",
    "        QS_vec[i] = QS(psi_l, ss, Tl, EE, Ksm, b, psi_s0, Zrm, psi_50)\n",
    "\n",
    "        psiw_vec[i] = psi_w(ws, Tl)\n",
    "        psis_vec[i] = psi_s(ss, b, psi_s0)\n",
    "\n",
    "        # virtual sensible heat\n",
    "        Hv_i = H[i] + RAT * theta[i] * cp * EE * rho_w / conv\n",
    "\n",
    "        # stomatal conductance\n",
    "        STOM[i] = (\n",
    "            gstom(psil_vec[i], psi_min, gst_max)\n",
    "            * fT(theta[i])\n",
    "            * fD(theta[i], Dx, qqq[i])\n",
    "            * fPAR(phi[i])\n",
    "        )\n",
    "\n",
    "        # boundary layer equations\n",
    "        q0 = gam_q * hh[i] + qf0\n",
    "        thetav = gam_theta * hh[i] + theta_f0\n",
    "\n",
    "        dhdt = (\n",
    "            (1 + 2 * Beta) * max(Hv_i, 0)\n",
    "            / (rho_a * cp * gam_theta * hh[i])\n",
    "        )\n",
    "\n",
    "        dqdt = (\n",
    "            rho_w * EE / conv\n",
    "            + dhdt * rho_a * (-qqq[i] + q0)\n",
    "        ) / (rho_a * hh[i])\n",
    "\n",
    "        dthdt = (\n",
    "            Hv_i\n",
    "            + rho_a * cp * (-thetavir[i] + thetav) * dhdt\n",
    "        ) / (rho_a * cp * hh[i])\n",
    "\n",
    "        # update atmosphere\n",
    "        thetavir[i + 1] = thetavir[i] + dt * dthdt * 86400\n",
    "        hh[i + 1] = hh[i] + dt * dhdt * 86400\n",
    "        qqq[i + 1] = qqq[i] + dt * dqdt * 86400\n",
    "\n",
    "        # update soil moisture\n",
    "        s_losses = (-QS_vec[i] - ET_vec[i]) / (n * Zr)\n",
    "        ss_vec[i + 1] = ss_vec[i] + s_losses * dt\n",
    "\n",
    "    # Return the saved series in the order used by the figure sections.\n",
    "    return CAPE, thetavir, hh, qqq, lcl, ss_vec, ssCAC, CT, Tr_vec, CAC, STOM\n"
   ]
  },
  {
