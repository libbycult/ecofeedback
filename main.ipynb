    "\n",
    "#Figure 3\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# ============================================================\n",
    "# Settings used for the cases shown below\n",
    "# ============================================================\n",
    "\n",
    "ZR = 800\n",
    "soil_type = \"sandy loam\"\n",
    "s0_values = [0.5, 0.4, 0.3]\n",
    "psi50_values = [-1, -2, -4, -7]\n",
    "\n",
    "# Use hours for the daily plots.\n",
    "base_time = np.linspace(0, 24 * length, int(length / dt))\n",
    "\n",
    "# ============================================================\n",
    "# Plot settings for all three rows\n",
    "# ============================================================\n",
    "\n",
    "plt.rcParams.update({\n",
    "    \"font.family\": \"sans\",\n",
    "    \"mathtext.fontset\": \"dejavusans\",\n",
    "    \"font.size\": 10,\n",
    "    \"axes.labelsize\": 10,\n",
    "    \"axes.titlesize\": 10,\n",
    "    \"legend.fontsize\": 8,\n",
    "    \"xtick.labelsize\": 8.5,\n",
    "    \"ytick.labelsize\": 8.5,\n",
    "    \"axes.linewidth\": 1.0,\n",
    "    \"xtick.direction\": \"out\",\n",
    "    \"ytick.direction\": \"out\"\n",
    "})\n",
    "\n",
    "linestyles = [\"-\", \"--\", \"-.\", \":\"]\n",
    "\n",
    "labels = {\n",
    "    -1: r\"$\\psi_{50}=-1$ MPa\",\n",
    "    -2: r\"$\\psi_{50}=-2$ MPa\",\n",
    "    -4: r\"$\\psi_{50}=-4$ MPa\",\n",
    "    -7: r\"$\\psi_{50}=-7$ MPa\",\n",
    "}\n",
    "\n",
    "# ============================================================\n",
    "# Run each case once and keep its output\n",
    "# return CAPE, thetavir, hh, qqq, lcl, ss_vec, ssCAC, CT, Tr_vec, CAC, STOM\n",
    "# ============================================================\n",
    "\n",
    "def solve_case(args):\n",
    "    s0, psi50 = args\n",
    "    return CAPE_solver(\n",
    "        ZR,\n",
    "        psi50,\n",
    "        psimin(psi50),\n",
    "        gmax(psi50),\n",
    "        soil_type,\n",
    "        s0\n",
    "    )\n",
    "\n",
    "case_args = [(s0, psi50) for s0 in s0_values for psi50 in psi50_values]\n",
    "\n",
    "# Run sequentially so this cell works in ordinary Jupyter kernels, including on macOS.\n",
    "case_outputs = [solve_case(args) for args in case_args]\n",
    "\n",
    "results = dict(zip(case_args, case_outputs))\n",
    "\n",
    "\n",
    "def unpack(out):\n",
    "    CAPE, thetavir, hh, qqq, lcl, ss_vec, ssCAC, CT, Tr_vec, CAC, STOM = out\n",
    "\n",
    "    return {\n",
    "        \"CAPE\": np.asarray(CAPE).squeeze(),\n",
    "        \"thetavir\": np.asarray(thetavir).squeeze(),\n",
    "        \"hh\": np.asarray(hh).squeeze(),\n",
    "        \"qqq\": np.asarray(qqq).squeeze(),\n",
    "        \"lcl\": np.asarray(lcl).squeeze(),\n",
    "        \"ss_vec\": np.asarray(ss_vec).squeeze(),\n",
    "        \"ssCAC\": np.asarray(ssCAC).squeeze(),\n",
    "        \"CT\": np.asarray(CT).squeeze(),\n",
    "        \"Tr_vec\": np.asarray(Tr_vec).squeeze(),\n",
    "        \"CAC\": np.asarray(CAC).squeeze(),\n",
    "        \"STOM\": np.asarray(STOM).squeeze()\n",
    "    }\n",
    "\n",
    "\n",
    "def get_case(s0, psi50):\n",
    "    return unpack(results[(s0, psi50)])\n",
    "\n",
    "\n",
    "def time_for(y):\n",
    "    return np.linspace(0, 24 * length, len(y))\n",
    "\n",
    "\n",
    "def find_crossing(h, lcl, y_curve):\n",
    "    h = np.asarray(h).squeeze()\n",
    "    lcl = np.asarray(lcl).squeeze()\n",
    "    y_curve = np.asarray(y_curve).squeeze()\n",
    "\n",
    "    n = min(len(h), len(lcl), len(y_curve))\n",
    "    h = h[:n]\n",
    "    lcl = lcl[:n]\n",
    "    y_curve = y_curve[:n]\n",
    "\n",
    "    t = np.linspace(0, 24 * length, n)\n",
    "\n",
    "    diff = h - lcl\n",
    "    idx = np.where(np.diff(np.sign(diff)) != 0)[0]\n",
    "\n",
    "    if len(idx) == 0:\n",
    "        return None\n",
    "\n",
    "    i = idx[0]\n",
    "\n",
    "    t0, t1 = t[i], t[i + 1]\n",
    "    d0, d1 = diff[i], diff[i + 1]\n",
    "\n",
    "    t_cross = t0 - d0 * (t1 - t0) / (d1 - d0)\n",
    "    frac = (t_cross - t0) / (t1 - t0)\n",
    "\n",
    "    y_cross = y_curve[i] + (y_curve[i + 1] - y_curve[i]) * frac\n",
    "    cross_hour = t_cross % 24\n",
    "\n",
    "    return cross_hour, y_cross\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# Build the nine-panel figure\n",
    "# ============================================================\n",
    "\n",
    "def plot_combined_curves(fname=\"stom_lcl_cape_combined.pdf\"):\n",
    "\n",
    "    fig, axes = plt.subplots(\n",
    "        3, 3,\n",
    "        figsize=(10, 10),\n",
    "        dpi=250,\n",
    "        sharex=False,\n",
    "        sharey=False\n",
    "    )\n",
    "\n",
    "    y_max_stom = [6.5, 5.1, 1.5]\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Row 1: stomatal conductance g_s\n",
    "    # --------------------------------------------------------\n",
    "    for j, s0 in enumerate(s0_values):\n",
    "        ax = axes[0, j]\n",
    "\n",
    "        for psi50, ls in zip(psi50_values, linestyles):\n",
    "            out = get_case(s0, psi50)\n",
    "\n",
    "            gs = out[\"STOM\"]\n",
    "            t = time_for(gs)\n",
    "\n",
    "            n = min(len(t), len(gs))\n",
    "\n",
    "            ax.plot(\n",
    "                t[:n],\n",
    "                gs[:n] * 1000,\n",
    "                color=\"black\",\n",
    "                linestyle=ls,\n",
    "                linewidth=1.4,\n",
    "                label=labels[psi50]\n",
    "            )\n",
    "\n",
    "        ax.set_xlim(6, 18)\n",
    "        ax.set_ylim(0, y_max_stom[j])\n",
    "        ax.set_title(rf\"$s_0={s0}$\")\n",
    "        ax.set_xlabel(\"Hour of Day\")\n",
    "\n",
    "        if j == 0:\n",
    "            ax.set_ylabel(r\"Stomatal Conductance (mm s$^{-1}$)\")\n",
    "            ax.legend(frameon=False)\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Row 2: LCL and boundary-layer height h\n",
    "    # --------------------------------------------------------\n",
    "    for j, s0 in enumerate(s0_values):\n",
    "        ax = axes[1, j]\n",
    "\n",
    "        for psi50, ls in zip(psi50_values, linestyles):\n",
    "            out = get_case(s0, psi50)\n",
    "\n",
    "            lcl = out[\"lcl\"]\n",
    "            h = out[\"hh\"]\n",
    "\n",
    "            t_lcl = time_for(lcl)\n",
    "            t_h = time_for(h)\n",
    "\n",
    "            n_lcl = min(len(t_lcl), len(lcl))\n",
    "            n_h = min(len(t_h), len(h))\n",
    "\n",
    "            ax.plot(\n",
    "                t_lcl[:n_lcl],\n",
    "                lcl[:n_lcl],\n",
    "                color=\"red\",\n",
    "                linestyle=ls,\n",
    "                linewidth=1.3,\n",
    "                label=labels[psi50]\n",
    "            )\n",
    "\n",
    "            ax.plot(\n",
    "                t_h[:n_h],\n",
    "                h[:n_h],\n",
    "                color=\"blue\",\n",
    "                linestyle=ls,\n",
    "                linewidth=1.3\n",
    "            )\n",
    "\n",
    "            cross = find_crossing(h, lcl, h)\n",
    "\n",
    "            if cross is not None:\n",
    "                cross_hour, h_cross = cross\n",
    "                ax.plot(\n",
    "                    cross_hour,\n",
    "                    h_cross,\n",
    "                    marker=\"*\",\n",
    "                    color=\"black\",\n",
    "                    markersize=7,\n",
    "                    zorder=5\n",
    "                )\n",
    "\n",
    "        ax.set_xlim(6, 18)\n",
    "        ax.set_title(rf\"$s_0={s0}$\")\n",
    "        ax.set_xlabel(\"Hour of Day\")\n",
    "\n",
    "        if j == 0:\n",
    "            ax.set_ylabel(\"Height (m)\")\n",
    "            ax.legend(frameon=False, fontsize=7.5)\n",
    "\n",
    "    # --------------------------------------------------------\n",
    "    # Row 3: CAPE\n",
    "    # --------------------------------------------------------\n",
    "    for j, s0 in enumerate(s0_values):\n",
    "        ax = axes[2, j]\n",
    "\n",
    "        for psi50, ls in zip(psi50_values, linestyles):\n",
    "            out = get_case(s0, psi50)\n",
    "\n",
    "            cape = out[\"CAPE\"]\n",
    "            lcl = out[\"lcl\"]\n",
    "            h = out[\"hh\"]\n",
    "\n",
    "            t = time_for(cape)\n",
    "            n = min(len(t), len(cape))\n",
    "\n",
    "            ax.plot(\n",
    "                t[:n],\n",
    "                cape[:n],\n",
    "                color=\"black\",\n",
    "                linestyle=ls,\n",
    "                linewidth=1.4,\n",
    "                label=labels[psi50]\n",
    "            )\n",
    "\n",
    "            cross = find_crossing(h, lcl, cape)\n",
    "\n",
    "            if cross is not None:\n",
    "                cross_hour, cape_cross = cross\n",
    "                ax.plot(\n",
    "                    cross_hour,\n",
    "                    cape_cross,\n",
    "                    marker=\"*\",\n",
    "                    color=\"black\",\n",
    "                    markersize=7,\n",
    "                    zorder=5\n",
    "                )\n",
    "\n",
    "        ax.set_xlim(6, 18)\n",
    "        ax.set_ylim(0, 1850)\n",
    "        ax.set_title(rf\"$s_0={s0}$\")\n",
    "        ax.set_xlabel(\"Hour of Day\")\n",
    "\n",
    "        if j == 0:\n",
    "            ax.set_ylabel(r\"CAPE (J kg$^{-1}$)\")\n",
    "            ax.legend(frameon=False)\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(fname, dpi=400, bbox_inches=\"tight\")\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "plot_combined_curves()"
   ]
  },
